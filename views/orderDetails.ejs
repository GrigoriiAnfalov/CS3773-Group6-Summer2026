<!DOCTYPE html>
<html>
<head>
    <title>Order #<%= order.id %> Details</title>
    <link rel="stylesheet" href="public/css/style.css">
</head>
<body>
    <div class="container">
        <div class="nav-buttons">
            <form action="/orders" method="GET" style="display:inline;">
                <button type="submit" style="background: #6b7280;">&larr; Back to Orders</button>
            </form>
        </div>

        <h1>Order #<%= order.id %> Summary</h1>

        <!-- Order Summary -->
        <table class="summary-table">
            <tbody>
                <tr>
                    <th>Customer Username</th>
                    <td><%= order.user %></td>
                </tr>
                <tr>
                    <th>Order Date</th>
                    <td><%= order.order_date %></td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td><strong><%= order.status %></strong></td>
                </tr>
                <tr>
                    <th>Total Amount</th>
                    <td><strong>$<%= order.totalAmount %></strong></td>
                </tr>
            </tbody>
        </table>

        <hr>

        <!-- Line Items -->
        <h2>Items in Order</h2>
        <table>
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
                <% order.items.forEach(function(item) { %>
                <tr>
                    <td><img src="/uploads/<%= item.image_url %>" alt="<%= item.name %>" width="50" style="border-radius: 4px;"></td>
                    <td><%= item.name %></td>
                    <td><%= item.item_quantity %></td>
                    <td>$<%= item.price %></td>
                    <td>$<%= (item.item_quantity * item.price).toFixed(2) %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <hr>

        <!-- Execute Order -->
        <% if (order.status === 'Pending') { %>
        <form action="/orders/execute/<%= order.id %>" method="POST" style="display:inline;">
            <button type="submit" class="execute">Execute Order</button>
        </form>
        <% } %>
    </div>
</body>
</html>
